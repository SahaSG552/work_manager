# MAX → Telegram Bridge Configuration
# Copy to .env and fill in your values

# MAX account phone number (with country code)
MAX_PHONE=+7XXXXXXXXXX

# Telegram bot token (from @BotFather)
TG_BOT_TOKEN=

# Target Telegram group chat ID (negative for supergroups)
TG_CHAT_ID=-1003914208415

# Topic/thread ID within the group (optional, for forum groups)
# TG_TOPIC_ID=

# Directory for pymax session files
MAX_SESSION_DIR=./sessions

# MAX chat IDs to monitor (comma-separated, empty = all)
# MAX_CHATS=

# MAX chat IDs to ignore (comma-separated)
# MAX_BLACKLIST=
